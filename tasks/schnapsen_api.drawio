        <mxCell id="schnapsen_cu" edge="1" parent="1" style="edgeStyle=none;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=#111111;strokeWidth=2;dashed=1;dashPattern=5 4;endArrow=open;endFill=0;fontFamily=Arial;fontSize=13;fontColor=#111111;labelBackgroundColor=none;" value="Показывает результат раунда">
