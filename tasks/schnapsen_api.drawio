        <mxCell id="schnapsen_api" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#111111;spacingTop=2;" value="POST /games/{game_id}/schnapsen&lt;br&gt;&lt;br&gt;Заголовок: Authorization: Bearer {access_token}&lt;br&gt;&lt;br&gt;Тело запроса:&lt;br&gt;{ game_id }" vertex="1">
