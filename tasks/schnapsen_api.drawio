        <mxCell id="schnapsen_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=1;" value="9. Объявление шнапса (≥66 очков)" vertex="1">
          <mxGeometry height="30" width="830" x="35" y="2670" as="geometry" />
        </mxCell>
        <mxCell id="schnapsen_uc" edge="1" parent="1" style="edgeStyle=none;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;fontColor=#111111;labelBackgroundColor=none;" value="Нажимает «Шнапс!»">
