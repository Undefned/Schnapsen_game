        <mxCell id="schnapsen_cs" edge="1" parent="1" style="edgeStyle=none;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=#111111;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;fontColor=#111111;labelBackgroundColor=none;" value="access_token, game_id">
          <mxGeometry relative="1" as="geometry">
