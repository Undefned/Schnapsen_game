        </mxCell>
        <mxCell id="marriage_uc" edge="1" parent="1" style="edgeStyle=none;html=1;whiteSpace=nowrap;overflow=visible;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;fontColor=#111111;labelBackgroundColor=none;" value="Кладёт короля и даму одной масти">
